model Service {
  id           String   @id @default(uuid())
  title        String
  description  String
  price        Float
  technicianId String
  technician   User     @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings Booking[]

  @@index([technicianId])
  @@index([title])
  @@map("services")
}
